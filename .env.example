# ==================================================================
#  Xyverse Admin — variabel lingkungan
#
#  Di Vercel: isi lewat dashboard (Project → Settings →
#  Environment Variables) untuk Production & Preview.
#  Di lokal : salik file ini menjadi .env, lalu `npm run dev`.
# ==================================================================

# ---- GitHub (dipakai API serverless) ----
# Personal Access Token (fine-grained) dengan izin
# "Contents: Read and write" pada repo xyverse-web
# (dan xyverse-admin bila ingin panel status kedua repo).
# Token HANYA dibaca server — tidak pernah dikirim ke peramban.
GH_TOKEN=

GH_OWNER=xykalnotkel
GH_SITE_REPO=xyverse-web
GH_ADMIN_REPO=xyverse-admin
GH_BRANCH=main

# ---- Groq AI ----
# Ambil kunci gratis di https://console.groq.com/keys
GROQ_API_KEY=
# Model produksi Groq 2026 (llama-3.1-8b & llama-3.3-70b sudah dimatikan Agt 2026)
#   openai/gpt-oss-20b   -> cepat & murah  (~1000 tok/s)  [disarankan]
#   openai/gpt-oss-120b  -> lebih pintar   (~500 tok/s)
#   groq/compound        -> sistem agentik, bisa telusur web
GROQ_MODEL=openai/gpt-oss-20b

# ---- Login admin ----
# Nama pengguna untuk masuk ke dashboard
ADMIN_USER=admin

# Hash bcrypt kata sandi. JANGAN simpan kata sandi polos di sini.
# Buat hash baru:  npm run hash -- "katasandi rahasia lu"
ADMIN_PASS_HASH=

# Kunci penanda tangan cookie sesi (acak, minimal 32 karakter).
# WAJIB diisi di Vercel — kalau kosong, sesi hangus tiap cold start.
# Buat:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Cloudflare Turnstile ----
# Ambil di https://dash.cloudflare.com -> Turnstile -> Add site
# Kalau DIKOSONGKAN, verifikasi dilewati (mode pengembangan lokal saja).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- (hanya dev lokal) ----
# Port API lokal; Vite mem-proxy /api ke sini.
PORT=4500

# ---- (build-time, dipakai frontend) ----
# URL situs publik — tombol "Buka website" & "Lihat di situs".
VITE_SITE_URL=https://xyverse.my.id
VITE_SITE_LANG=id
